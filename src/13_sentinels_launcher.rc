#include <winuser.h>
#include <winver.h>
#include "tsr_version.h"

1 ICON "../packaging/icons/app-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TSR_VERSION_NUMBERS
PRODUCTVERSION TSR_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saulob"
            VALUE "FileDescription", "13 Sentinels: Aegis Rim PC Port launcher"
            VALUE "FileVersion", TSR_FILE_VERSION_STRING
            VALUE "InternalName", "13_sentinels_launcher"
            VALUE "OriginalFilename", "13_sentinels_launcher.exe"
            VALUE "ProductName", "13 Sentinels: Aegis Rim PC Port launcher"
            VALUE "ProductVersion", TSR_VERSION_STRING
            VALUE "Comments", "https://github.com/saulob/13-sentinels-aegis-rim-pc"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
