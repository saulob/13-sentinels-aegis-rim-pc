# The FFmpeg the Linux build decodes the game's videos with (tools/build-ffmpeg-linux.sh): the release the Windows
# build gets from MSYS2, built here as an LGPL decode-only library. The tarball is the one signed by the FFmpeg release
# signing key FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8. nasm only assembles FFmpeg's x86 code; it is not shipped.
FFMPEG_VERSION=8.1.1
